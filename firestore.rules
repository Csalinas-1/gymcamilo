rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Perfil, rutinas, entrenamientos y marcas de cada atleta
    match /users/{userId} {
      allow read, write: if true;
    }
    match /users/{userId}/{document=**} {
      allow read, write: if true;
    }

    // Librería global de ejercicios agrupada por zona muscular
    match /exercises/{exerciseId} {
      allow read, write: if true;
    }
  }
}
